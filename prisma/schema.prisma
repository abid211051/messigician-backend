generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  user
  admin
  moderator
}

enum mess_role {
  owner
  manager
  member
}

enum join_request_status {
  pending
  approved
  rejected
  cancelled
}

model users {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String           @unique
  role             user_role        @default(user)
  ban              Boolean          @default(false)
  ban_reason       String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  mess_id          String?          @db.Uuid
  sub_mess_id      String?          @db.Uuid
  mess_role        mess_role?
  monthly_rent     Decimal?         @db.Decimal(10, 2)
  total_due        Decimal?         @db.Decimal(10, 2)
  profiles         profiles?
  refresh_tokens   refresh_tokens[]
  join_requests    join_requests[]  @relation("requester")
  decided_requests join_requests[]  @relation("decider")
  mess             mess?            @relation(fields: [mess_id], references: [id], onUpdate: NoAction)
  sub_mess         sub_mess?        @relation(fields: [sub_mess_id, mess_id], references: [id, mess_id], onUpdate: NoAction)
}

model profiles {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @unique @db.Uuid
  fname      String?
  images     Json?    @default("[]")
  phone      String?  @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model mess {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  images        Json?           @default("[]")
  join_code     String          @unique
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  sub_mess      sub_mess[]
  users         users[]
  join_requests join_requests[]
}

model sub_mess {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mess_id       String          @db.Uuid
  name          String
  total_rent    Decimal?        @db.Decimal(10, 2)
  total_utility Decimal?        @db.Decimal(10, 2)
  no_of_seats   Int             @default(1)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  mess          mess            @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  users         users[]
  join_requests join_requests[]

  @@unique([id, mess_id])
  @@index([mess_id])
}

model join_requests {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String              @db.Uuid
  mess_id     String              @db.Uuid
  sub_mess_id String              @db.Uuid
  status      join_request_status @default(pending)
  decided_by  String?             @db.Uuid
  decided_at  DateTime?
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  users       users               @relation("requester", fields: [user_id], references: [id], onDelete: Cascade)
  decider     users?              @relation("decider", fields: [decided_by], references: [id])
  mess        mess                @relation(fields: [mess_id], references: [id], onDelete: Cascade)
  sub_mess    sub_mess            @relation(fields: [sub_mess_id, mess_id], references: [id, mess_id], onDelete: Cascade)

  @@unique([user_id, mess_id, sub_mess_id])
  @@index([mess_id, status])
}
