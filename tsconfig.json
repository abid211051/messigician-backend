{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "target": "ES2023",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],

    /* 🔴 CRITICAL DEVELOPMENT OPTIMIZATIONS */
    "incremental": true,
    "sourceMap": false, // Turn off to stop generating bulky map files on save
    "declaration": false, // Set to false; you do not need .d.ts files for local dev
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  /* 🔴 ENSURE THESE ARE EXCLUSIVELY BLOCKED */
  "exclude": ["node_modules", "dist", ".next"]
}

